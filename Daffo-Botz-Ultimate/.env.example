# Generate the real file using: python scripts/setup.py
# Jangan commit .env yang asli.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ENCRYPTION_KEY=
PUBLIC_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
BOT_MODE=whatsapp
DATA_DIR=data
HOST=0.0.0.0
PORT=8000

# AI endpoint host allowlist. Tambahkan host provider lain dengan koma jika diperlukan.
AI_ALLOWED_HOSTS=bandelbanget.xyz

